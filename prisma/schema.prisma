generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Vehicle {
  id             Int      @id @default(autoincrement())
  name           String
  make           String
  model          String
  year           Int
  currentMileage Int
  createdAt      DateTime @default(now())

  maintenanceRecords MaintenanceRecord[]
  serviceReminders   ServiceReminder[]
}

model MaintenanceRecord {
  id          Int      @id @default(autoincrement())
  vehicleId   Int
  vehicle     Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  serviceType String
  date        DateTime
  mileage     Int
  cost        Float
  shopName    String?
  notes       String?

  @@index([vehicleId])
}

model ServiceReminder {
  id             Int     @id @default(autoincrement())
  vehicleId      Int
  vehicle        Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  serviceType    String
  intervalKm     Int?
  intervalMonths Int?

  @@index([vehicleId])
}
